---
import '../styles/global.css';
import Topbar from '../components/Topbar.astro';

interface Props {
  title: string;
  // A tournament page's Standings/Statistics content wants to fill the
  // viewport horizontally; every other page uses the default, narrower
  // reading-width container.
  wide?: boolean;
}

const { title, wide = false } = Astro.props as Props;
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Poke Standings</title>
  </head>
  <body>
    <Topbar />
    <main class={`page-container ${wide ? 'page-container--wide' : ''}`}>
      <slot />
    </main>
  </body>
</html>
